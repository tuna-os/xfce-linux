# XFCE Linux opinionated desktop defaults (adw-gtk3 dark theme, icons, layout)

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='Adwaita'
font-name='Sans 10'

[org/xfce/desktop/screensaver]
lock-enabled=true
lock-command='xflock4'

[org/xfce/session]
save-on-exit=true
